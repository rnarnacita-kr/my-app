      "columns": [
        {"name": "sku", "type": "VARCHAR", "meaning": "상품 코드. 단품은 S0001 형태, 세트는 SET01 형태", "examples": ["S0001", "SET18"]},
        {"name": "product_name", "type": "VARCHAR", "meaning": "표준 상품명", "examples": ["세탁세제 대", "세탁세제 250ml"]},
        {"name": "category", "type": "VARCHAR", "meaning": "카테고리 (6개)", "examples": ["생활용품", "식품", "뷰티", "건강기능식품", "주방", "반려동물"]},
