        {"name": "mall", "type": "VARCHAR", "meaning": "쇼핑몰 이름 (5개)", "examples": ["자사몰", "오픈마켓A", "오픈마켓B", "소셜커머스", "종합몰"]},
        {"name": "order_date", "type": "DATE", "meaning": "주문일", "examples": ["2024-07-01"]},
        {"name": "mall_product_name", "type": "VARCHAR", "meaning": "쇼핑몰이 쓰는 상품명. 쇼핑몰마다 표기가 달라 조인 키로 쓰지 않는다", "examples": ["간식 60개입 특가"]},
        {"name": "sku", "type": "VARCHAR", "meaning": "상품 코드 (조인 키 → products.sku)", "examples": ["S0105", "SET18"]},
        {"name": "qty", "type": "BIGINT", "meaning": "주문 수량", "examples": [1, 3]},
