      "row_count": 54407,
      "key": ["ship_id"],
      "columns": [
        {"name": "ship_id", "type": "VARCHAR", "meaning": "출고 번호", "examples": ["SH0000001"]},
        {"name": "order_no", "type": "VARCHAR", "meaning": "주문 번호 (order_no + line_no로 mall_orders와 연결)", "examples": ["OD0000002"]},
