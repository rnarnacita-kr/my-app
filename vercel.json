{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/sql.py": {
      "includeFiles": "{schema.json,sqlguard_rules.json}",
      "maxDuration": 60
    },
    "api/why.py": {
      "includeFiles": "{schema.json,sqlguard_rules.json}",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
